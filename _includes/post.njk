---
layout: base.njk
---
<article class="article">
  <header class="article-header">
    <p class="eyebrow"><a href="/archive/">Articles</a></p>
    <h1>{{ title }}</h1>
    <div class="article-meta">
      <time datetime="{{ date | isoDate }}">{{ date | dateJa }}</time>
      {% if tags %}
        <span aria-hidden="true">·</span>
        <ul class="tag-list" aria-label="タグ">
          {% for tag in tags %}<li><a href="/tags/#{{ tag | tagId }}">#{{ tag }}</a></li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <footer class="article-footer">
    <a href="/archive/">← 記事一覧へ戻る</a>
  </footer>
</article>
